# Copy to .env for local development. Never commit .env or real secrets.

# --- Shared by both services ---
ENVIRONMENT=local            # local | staging | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
PORT=8080                    # Cloud Run injects this
GCP_PROJECT_ID=              # required when ENVIRONMENT is not local
# SERVICE_NAME=              # defaults to inventory-api / inventory-processor

# --- inventory-api ---
# Comma-separated list. Placeholder for local use only; in staging/prod the
# value comes from Secret Manager.
API_KEYS=local-dev-key-change-me
MAX_BATCH_SIZE=100           # 1-100

# Pub/Sub topic that receives accepted events. Required when ENVIRONMENT is not
# local. In local, leave it empty and events are only logged (no Google Cloud
# needed), or set it together with GCP_PROJECT_ID and PUBSUB_EMULATOR_HOST to
# use the Pub/Sub emulator.
PUBSUB_TOPIC_ID=
# PUBSUB_PUBLISH_TIMEOUT_SECONDS=10

# Protection. Both limits apply per Cloud Run instance.
# RATE_LIMIT_PER_MINUTE=600
# IDEMPOTENCY_TTL_SECONDS=900
# IDEMPOTENCY_MAX_ENTRIES=100000

# --- simulator ---
# SIMULATOR_API_KEY=local-dev-key-change-me

# --- inventory-processor ---
# With GCP_PROJECT_ID set the processor writes to BigQuery; without it (local only)
# events and alerts are kept in memory and lost on restart.
# BQ_DATASET=inventory_analytics
# BQ_EVENTS_TABLE=stock_events
# BQ_ALERTS_TABLE=stock_alerts
# BQ_TIMEOUT_SECONDS=5            # per BigQuery call
# BQ_RETRY_ATTEMPTS=3             # exponential backoff with jitter, transient errors only
# BQ_RETRY_BASE_DELAY_SECONDS=0.2
# BQ_RETRY_MAX_DELAY_SECONDS=2

# Alert rules.
# LOW_STOCK_THRESHOLD=5           # alert when 0 < quantity <= threshold
# RAPID_DROP_RATIO=0.5            # alert when stock falls by MORE than this share...
# RAPID_DROP_WINDOW_MINUTES=15    # ...within this window
# RAPID_DROP_MIN_BASELINE=4       # ignore drops from fewer units than this

# --- inventory-api read endpoints (GET /v1/alerts, /v1/metrics/stock-trends) ---
# Use the same GCP_PROJECT_ID and BQ_DATASET as above; without a project they return empty lists.
# BQ_TRENDS_VIEW=v_stock_trends
# BQ_TIMEOUT_SECONDS=8            # the API default is higher than the processor's
# BQ_RETRY_ATTEMPTS=2             # reads are synchronous: few retries
# ALERTS_DEFAULT_LOOKBACK_DAYS=7
# TRENDS_DEFAULT_LOOKBACK_HOURS=24
# TRENDS_MAX_RANGE_DAYS=31

# --- Added in later phases ---
